# Copia este archivo como ".env" (en la carpeta movil/) y ajusta las IPs.
#
# Emulador de Android Studio:  http://10.0.2.2:8000/api
# Celular físico (misma red WiFi que tu PC):  http://IP_DE_TU_PC:8000/api
#   (en Windows la IP sale con el comando: ipconfig  → "Dirección IPv4")
API_BASE_URL=http://10.0.2.2:8000/api

# Tiempo real (Laravel Reverb). Si no pones REVERB_HOST se usa el mismo host de API_BASE_URL.
REVERB_APP_KEY=alertas-key
REVERB_PORT=6001
REVERB_SCHEME=http
# REVERB_HOST=192.168.1.10

MAPBOX_ACCESS_TOKEN=pk.tu_token_de_mapbox
