digraph ER {
  graph [rankdir=RL, splines=true, concentrate=false, nodesep=0.6, ranksep=1.1, bgcolor="white", pad=0.4, fontname="Helvetica", label="Base de datos: alertas (PostgreSQL)", labelloc=t, fontsize=22];
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10, color="#5B6573", penwidth=1.3, dir=both, arrowtail=crow, arrowhead=tee];
