  users [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#9AA4B2"><tr><td colspan="3" bgcolor="#2F4F9A"><font color="white" point-size="13"><b>users</b></font></td></tr><tr><td align="left" port="id" bgcolor="#DCE7FB"><b>id</b></td><td align="left" bgcolor="#DCE7FB"><font color="#444444">uuid</font></td><td align="left" bgcolor="#DCE7FB"><font color="#A0001A"><b>PK</b></font></td></tr><tr><td align="left" port="first_name" bgcolor="#DCE7FB">first_name</td><td align="left" bgcolor="#DCE7FB"><font color="#444444">varchar(255)</font></td><td align="left" bgcolor="#DCE7FB"><font color="#666666"> </font></td></tr><tr><td align="left" port="last_name" bgcolor="#DCE7FB">last_name</td><td align="left" bgcolor="#DCE7FB"><font color="#444444">varchar(255)</font></td><td align="left" bgcolor="#DCE7FB"><font color="#666666"> </font></td></tr><tr><td align="left" port="phone" bgcolor="#DCE7FB">phone</td><td align="left" bgcolor="#DCE7FB"><font color="#444444">varchar(20)</font></td><td align="left" bgcolor="#DCE7FB"><font color="#666666">UQ</font></td></tr><tr><td align="left" port="password" bgcolor="#DCE7FB">password</td><td align="left" bgcolor="#DCE7FB"><font color="#444444">varchar(255)</font></td><td align="left" bgcolor="#DCE7FB"><font color="#666666"> </font></td></tr><tr><td align="left" port="refresh_token" bgcolor="#DCE7FB">refresh_token</td><td align="left" bgcolor="#DCE7FB"><font color="#444444">varchar(255)</font></td><td align="left" bgcolor="#DCE7FB"><font color="#666666">NULL</font></td></tr><tr><td align="left" port="fcm_token" bgcolor="#DCE7FB">fcm_token</td><td align="left" bgcolor="#DCE7FB"><font color="#444444">varchar(255)</font></td><td align="left" bgcolor="#DCE7FB"><font color="#666666">NULL</font></td></tr><tr><td align="left" port="last_latitude" bgcolor="#DCE7FB">last_latitude</td><td align="left" bgcolor="#DCE7FB"><font color="#444444">double precision</font></td><td align="left" bgcolor="#DCE7FB"><font color="#666666"