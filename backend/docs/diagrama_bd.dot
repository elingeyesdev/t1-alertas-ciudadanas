  report_types [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#9AA4B2"><tr><td colspan="3" bgcolor="#B86E14"><font color="white" point-size="13"><b>report_types</b></font></td></tr><tr><td align="left" port="id" bgcolor="#FDF0DC"><b>id</b></td><td align="left" bgcolor="#FDF0DC"><font color="#444444">bigserial</font></td><td align="left" bgcolor="#FDF0DC"><font color="#A0001A"><b>PK</b></font></td></tr><tr><td align="left" port="name" bgcolor="#FDF0DC">name</td><td align="left" bgcolor="#FDF0DC"><font color="#444444">varchar(255)</font></td><td align="left" bgcolor="#FDF0DC"><font color="#666666"> </font></td></tr><tr><td align="left" port="base_weight" bgcolor="#FDF0DC">base_weight</td><td align="left" bgcolor="#FDF0DC"><font color="#444444">integer</font></td><td align="left" bgcolor="#FDF0DC"><font color="#666666">default 1</font></td></tr></table>>];
