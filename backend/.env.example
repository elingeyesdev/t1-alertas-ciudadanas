APP_NAME="Alertas Ciudadanas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------- Base de datos PostgreSQL ----------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=alertas
DB_USERNAME=postgres
DB_PASSWORD=123

SESSION_DRIVER=file
SESSION_LIFETIME=120

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Caché (también guarda los trackings en vivo). Usa "redis" si tienes Redis.
CACHE_STORE=database
TRACKING_CACHE_STORE=
TRACKING_TTL_SECONDS=120

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------- JWT (igual que en NestJS) ----------
JWT_SECRET=cambia_esta_clave_por_una_larga_y_secreta_minimo_32_caracteres
ACCESS_TOKEN_VALIDITY_DURATION_IN_HOURS=1h
REFRESH_TOKEN_VALIDITY_DURATION_IN_HOURS=72h

# ---------- Administrador inicial (seeder) ----------
ADMIN_PHONE=70000000
ADMIN_PASSWORD=admin123

# ---------- Cloudinary (si queda "pendiente" las imágenes se guardan en storage/app/public) ----------
CLOUDINARY_CLOUD_NAME=pendiente
CLOUDINARY_API_KEY=pendiente
CLOUDINARY_API_SECRET=pendiente
CLOUDINARY_FOLDER=prueba

# ---------- Firebase Cloud Messaging ----------
# Copia firebase-service-account.json a storage/app/
FIREBASE_CREDENTIALS=storage/app/firebase-service-account.json

# ---------- Correo (Gmail con contraseña de aplicación) ----------
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=pendiente@gmail.com
MAIL_PASSWORD=pendiente
MAIL_FROM_ADDRESS="${MAIL_USERNAME}"
MAIL_FROM_NAME="Sistema de Alertas"

# ---------- WebSockets en tiempo real (Laravel Reverb) ----------
# Pon BROADCAST_CONNECTION=log si no vas a levantar Reverb
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=alertas
REVERB_APP_KEY=alertas-key
REVERB_APP_SECRET=alertas-secret
REVERB_HOST=localhost
REVERB_PORT=6001
REVERB_SERVER_PORT=6001
REVERB_SCHEME=http
