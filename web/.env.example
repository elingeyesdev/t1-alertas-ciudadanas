# ---------- API Laravel ----------
# Déjalo vacío para usar el proxy de Vite (/api -> http://localhost:8000).
# Para probar desde el celular o en producción pon la URL completa, ej: http://192.168.1.10:8000/api
VITE_API_URL=
# Destino del proxy de Vite en desarrollo
VITE_API_PROXY_TARGET=http://localhost:8000

# ---------- Tiempo real (Laravel Reverb) ----------
# Deben coincidir con REVERB_APP_KEY / REVERB_PORT del backend
VITE_REVERB_APP_KEY=alertas-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=6001
VITE_REVERB_SCHEME=http

# ---------- Mapbox ----------
VITE_MAPBOX_TOKEN=pk.tu_token_de_mapbox
